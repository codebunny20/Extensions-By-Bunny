{
  "manifest_version": 3,
  "name": "Bunny Book",
  "version": "1.0",
  "description": "A cozy multi-note notepad/book.",
  "permissions": ["storage", "microphone"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "64": "icons/icon64.png"
    }
  }
}