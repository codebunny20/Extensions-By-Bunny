{
  "manifest_version": 3,
  "name": "Show Page Text test",
  "version": "1.0.0",
  "permissions": ["scripting", "activeTab", "storage", "downloads", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Show page text" },
  "web_accessible_resources": [
    {
      "resources": ["viewer.html", "viewer.css", "viewer.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
