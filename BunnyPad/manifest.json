{
    "manifest_version": 3,
    "name": "BunnyPad",
    "description": "A cozy transfem-themed notepad that lives in your browser.",
    "version": "1.0.0",
    "action": {
      "default_popup": "popup.html",
      "default_title": "BunnyPad"
    },
    "permissions": [
      "storage"
    ]
  }
  