{
    "manifest_version": 3,
    "name": "WideScroll",
    "description": "Widen scrollbars on any webpage for easier clicking and dragging.",
    "version": "0.1",
    "action": {
      "default_popup": "popup.html",
      "default_title": "WideScroll"
    },
    "permissions": ["activeTab", "scripting", "storage"],
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "run_at": "document_start"
      }
    ],
    "web_accessible_resources": [
      {
        "resources": ["style.css"],
        "matches": ["<all_urls>"]
      }
    ]
  }
  