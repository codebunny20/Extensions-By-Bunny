{
  "name": "bunny-mathbox",
  "version": "1.0.0",
  "private": true,
  "description": "TypeScript build tooling for Bunny Mathbox",
  "scripts": {
    "build": "esbuild src/popup.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=popup.js",
    "watch": "esbuild src/popup.ts --bundle --format=iife --platform=browser --target=es2020 --outfile=popup.js --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.276",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3"
  }
}
