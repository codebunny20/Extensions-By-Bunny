{
    "manifest_version": 3,
    "name": "Auto Scroll",
    "version": "1.1.0",
    "description": "Automatically scroll web pages with smooth scrolling, jump scroll mode, and adjustable speed.",
    "permissions": [
        "activeTab",
        "scripting",
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Auto Scroll"
    },
    "background": {
        "service_worker": "dist/background.js"
    },
    "commands": {
        "toggle-autoscroll": {
            "suggested_key": {
                "default": "Ctrl+Shift+S"
            },
            "description": "Start or stop auto scroll on the active tab"
        },
        "pause-resume-autoscroll": {
            "suggested_key": {
                "default": "Ctrl+Shift+X"
            },
            "description": "Pause or resume auto scroll on the active tab"
        },
        "toggle-extension-enabled": {
            "suggested_key": {
                "default": "Ctrl+Shift+E"
            },
            "description": "Enable or disable Auto Scroll globally"
        }
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["dist/scroll.js"]
        }
    ],
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}