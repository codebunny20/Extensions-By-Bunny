{
  "manifest_version": 3,
  "name": "Reading zone text",
  "version": "1.0.0",
  "permissions": ["scripting", "activeTab", "storage", "downloads", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background/background.js" },
  "action": { "default_title": "Reading zone text", "default_popup": "popup/popup.html" },
  "web_accessible_resources": [
    {
      "resources": ["viewer/viewer.html", "viewer/viewer.css", "viewer/viewer.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
