{
    "manifest_version": 3,
    "name": "Reading Ruler",
    "version": "1.1",
    "description": "A horizontal reading ruler that follows your mouse to improve readability.",
    "permissions": ["storage"],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Reading Ruler"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["dist/content.js"]
      }
    ],
    "icons": {
      "16": "icons/16.png" 
    }
  }