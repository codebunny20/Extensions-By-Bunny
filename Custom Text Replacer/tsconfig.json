  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2015",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "sourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["chrome"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
