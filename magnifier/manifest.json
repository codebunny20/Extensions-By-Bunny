{
    "manifest_version": 3,
    "name": "Magnifier Glass",
    "version": "1.0.0",
    "description": "Toggleable, adjustable magnifying glass for any page.",
    "permissions": ["scripting", "activeTab", "storage"],
    "action": {
      "default_popup": "popup.html",
      "default_title": "Magnifier Glass"
    },
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "commands": {
      "toggle-magnifier": {
        "suggested_key": {
          "default": "Ctrl+Shift+M"
        },
        "description": "Toggle magnifier on current page"
      }
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"],
        "css": ["styles.css"],
        "run_at": "document_idle"
      }
    ]
  }
  