{
  "manifest_version": 3,
  "name": "Bunny TTS",
  "version": "2.0",
  "description": "Clean, modern text‑to‑speech for selected text.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bunny TTS"
  },
  "background": {
    "service_worker": "service_worker.js"
  },
  "commands": {
    "speak-selection": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Speak selected text"
    }
  }
}
