{
  "manifest_version": 3,
  "name": "PageSearch",
  "version": "1.0",
  "description": "Search for words and phrases on the current page.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/search.js"],
      "css": ["content/highlight.css"]
    }
  ]
}
