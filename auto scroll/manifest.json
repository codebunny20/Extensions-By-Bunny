{
    "manifest_version": 3,
    "name": "Auto Scroll Extension",
    "version": "1.0",
    "description": "A simple extension to test auto-scrolling functionality.",
    "permissions": [
        "activeTab",
        "scripting"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Auto Scroll"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["scroll.js"]
        }
    ]
}