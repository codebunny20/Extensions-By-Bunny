{
  "manifest_version": 3,
  "name": "ColorCursor",
  "version": "1.0.0",
  "description": "Change the mouse pointer color on websites by injecting a colored SVG cursor.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "Mouse Pointer Color",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/16.png" 
  }

}